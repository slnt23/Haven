# Environment variables for your Managed Deep Agent.
#
# `mda` loads this file on deploy and forwards non-reserved variables to
# your deployment as secrets. Do NOT commit real secrets to version control.
#
# 复制本文件为 .env 并填入你自己的值。.env 已加入 .gitignore，不会被提交。

# LangSmith API key — required to deploy. Create one under
# Settings > API Keys in LangSmith (https://smith.langchain.com).
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek API key — required by langchain-deepseek for model="deepseek:...".
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# # Database URL. Dev default (omit): sqlite+aiosqlite:///./.data/haven.db
# # Deploy MUST set a managed PostgreSQL, e.g.:
# # DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/haven
# DATABASE_URL=

# # Agent model (MDA format "<provider>:<model>"). Omit to use the code
# # default: deepseek:deepseek-v4-flash
# HAVEN_MODEL=deepseek:deepseek-v4-flash

# 本部署唯一服务的用户 id（单租户：一个部署 = 一个人）。健康数据全部记在
# 这个 id 名下，本机 dev 与云端部署因此是同一个人、同一份数据。
# 留空 => 代码默认 owner。改这个值等于换一个人用（旧数据不会跟过来）。
HAVEN_OWNER_ID=

# 外部 MCP 服务器清单见 config/mcp.json（随仓库提交；`{}` = 不接任何 MCP）。
# mcp.json 里的 ${VAR} 从本文件解析（部署时非保留变量会被转发为部署密钥），
# 例如：NEO4J_MCP_TOKEN=<你的令牌>（仅当 mcp.json 引用了它时才需要）。

# Model provider API keys. Uncomment the provider(s) your agent uses;
# they are forwarded to your deployment so the model can authenticate.
# OPENAI_API_KEY=  # OpenAI
# ANTHROPIC_API_KEY=  # Anthropic
# GOOGLE_API_KEY=  # Google Gemini
# GROQ_API_KEY=  # Groq
# MISTRAL_API_KEY=  # Mistral