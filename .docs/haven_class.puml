@startuml haven_class
' ============================================================================
' Haven Framework — Class Diagram
' ============================================================================

skinparam classAttributeIconSize 0
skinparam backgroundColor #FEFEFE
skinparam classBorderColor #333333
skinparam packageBorderColor #666666

' --------------------------------------------------------------------------
' Core Layer
' --------------------------------------------------------------------------

package "core" #E8F0FE {
    abstract class BaseAgent <<abstract>> {
        + name: str
        + llm: BaseChatModel
        + tools: dict
        + skills: dict
        + memory: AgentMemory
        + rag: RAGEngine
        + max_iterations: int
        + max_execution_time: int
        --
        + register_tool(name, tool)
        + register_lc_tool(tool)
        + register_mcp_tools(tools)
        + bind_tools_to_llm()
        + switch_model(name) : str
        + enable_skill(skill)
        + load_skills_from_dir(dir) : int
        + disable_skill(name)
        + enable_rag(rag)
        + match_skills(task) : list
        + reset()
        + save_turn(user_input, response)
        + extract_facts_async()
        --
        {abstract} + run(task, **kwargs) : str
        {abstract} + step(messages) : BaseMessage
        # _init_llm(model_name) : BaseChatModel
        # _build_system_prompt() : str
        # _invoke_llm(task, prompt, use_rag) : str
        # _invoke_llm_with_tools(task, prompt, use_rag) : str
        # _execute_tool_call(name, args) : str
    }

    class AgentMemory {
        - messages: deque[BaseMessage]
        + metadata: dict
        - _store: SQLiteMemoryStore
        - _session_id: str
        - _entity_name: str
        - _channel: str
        --
        + add_message(msg)
        + add_messages(msgs)
        + get_history() : list
        + clear()
        + session_id : str
        + entity_name : str
        + channel : str
        + save_message(role, content)
        + get_long_term_context(entity_name) : str
        + extract_facts(llm)
    }

    class SQLiteMemoryStore {
        - _db_path: Path
        - _conn: sqlite3.Connection
        --
        + get_or_create_entity(name, type) : int
        + get_entity_by_name(name) : dict
        + upsert_fact(entity_id, key, value, confidence, source)
        + upsert_facts_batch(entity_id, facts, source) : int
        + get_facts(entity_id, min_confidence) : list
        + get_facts_by_name(name, min_confidence) : list
        + format_facts_for_prompt(entity_id, min_confidence) : str
        + format_facts_by_name(name, min_confidence) : str
        + save_message(session_id, role, content, channel) : int
        + get_recent_messages(session_id, limit) : list
        + get_last_conversation_pair(session_id) : tuple
        + extract_and_store(entity_name, snippet, llm, source) : list
        - _parse_extraction(raw) : list
        + close()
    }

    ToolRegistry <<registry>> {
        - {static} _tools: dict
        --
        + {static} register(name) : decorator
        + {static} get(name) : class
        + {static} list_tools() : list
        + {static} clear()
    }

    class RAGEngine {
        - embeddings: OpenAIEmbeddings
        - vectorstore: InMemoryVectorStore
        --
        + add_texts(texts, metadatas)
        + add_files(paths)
        + add_directory(dir, glob)
        + retrieve(query, top_k) : list[Document]
        + format_context(docs) : str
        + doc_count : int
        + clear()
    }

    note right of SQLiteMemoryStore
        SQLite-backed long-term memory.
        Tables: entities, entity_facts,
        conversations.
        LLM-powered fact extraction
        from conversation turns.
    end note
}

' --------------------------------------------------------------------------
' Agent Layer
' --------------------------------------------------------------------------

package "agents" #E8F5E9 {
    class GeneralAgent {
        --
        + run(task, **kwargs) : str
        + step(messages) : BaseMessage
    }

    class OrchestratorAgent {
        + sub_agents: dict
        --
        + register_agent(name, agent)
        + run(task) : str
        + step(messages) : BaseMessage
    }
}

' --------------------------------------------------------------------------
' Skill Layer
' --------------------------------------------------------------------------

package "skills" #FFF3E0 {
    class BaseSkill <<data>> {
        + name: str
        + description: str
        + prompt: str
        + trigger_keywords: list
        + category: str
        + source_file: Path
        + default: bool
        --
        + prompt_extension : str
        + matches(task) : bool
    }

    class SkillLoader <<utility>> {
        --
        + {static} load_from_dir(dir) : list[BaseSkill]
        + {static} load_single(path) : BaseSkill
        - {static} _parse_file(path) : BaseSkill
        - {static} _split_frontmatter(raw) : tuple
    }

    class SkillRegistry <<registry>> {
        - {static} _skills: dict
        --
        + {static} register(name) : decorator
        + {static} get(name) : class
        + {static} list_skills() : list
        + {static} clear()
    }

    note right of BaseSkill
        Each .md file in skills/
        becomes one BaseSkill instance.
        default=true → always active
        default=false → on-demand (keyword match)
    end note
}

' --------------------------------------------------------------------------
' MCP Layer
' --------------------------------------------------------------------------

package "mcp" #EDE7F6 {
    class MCPServerConfig <<model>> {
        + name: str
        + transport: "stdio" | "http" | "websocket"
        + enabled: bool
        + description: str
        + command: str
        + args: list[str]
        + env: dict
        + url: str
        + headers: dict
        --
        + {static} from_standard_entry(name, entry) : MCPServerConfig
    }

    class MCPManager {
        - _configs: list[MCPServerConfig]
        - _exit_stack: AsyncExitStack
        - _tools: dict[str, BaseTool]
        - _active_servers: list[str]
        - _failed_servers: list[str]
        --
        + start() : dict[str, BaseTool]
        + stop()
        + tools : dict[str, BaseTool]
        + tool_list : list[BaseTool]
        + active_server_count : int
        + failed_server_count : int
        + get_status_summary() : str
        - _connect_one(cfg)
        - _connect_stdio(cfg)
        - _connect_http(cfg)
        - _connect_websocket(cfg)
        - {static} _resolve_env_vars(mapping) : dict
    }
}

' --------------------------------------------------------------------------
' Services Layer (Daemon + Channels)
' --------------------------------------------------------------------------

package "services" #E8F5E9 {
    abstract class BaseChannel <<abstract>> {
        + name: str
        + enabled: bool
        # _agent: BaseAgent
        --
        + handle_message(message) : str
        {abstract} + start(agent)
        {abstract} + stop()
    }

    class SocketChannel {
        + host: str
        + port: int
        - _server: asyncio.Server
        --
        + start(agent)
        + stop()
        - _handle_connection(reader, writer)
        - _process(user_input, history) : str
    }

    class EmailChannel {
        - _service: EmailService
        --
        + start(agent)
        + stop()
    }

    class EmailService {
        + smtp_host: str
        + smtp_port: int
        + imap_host: str
        + imap_port: int
        + whitelist: set
        + agent_handler: Callable
        --
        + send_email(to, subject, body, html) : bool
        + start()
        + stop()
        + run_forever()
        - _poll_inbox()
        - _fetch_unread_emails() : list
        - _digest_scheduler()
        - _send_digest()
    }

    class HavenDaemon {
        + agent: BaseAgent
        + channels: list[BaseChannel]
        - _running: bool
        - _shutdown_event: Event
        --
        + start()
        + stop()
        + run_forever()
        - _init_agent()
        - _init_mcp()
        - _build_channels()
        - _start_channels()
        - _register_signals()
        - _print_status()
    }

    note right of HavenDaemon
        Long-running daemon.
        Shares one Agent instance
        across all channels.
        Channels run as parallel
        asyncio tasks.
    end note
}

' --------------------------------------------------------------------------
' CLI Layer
' --------------------------------------------------------------------------

package "cli" #FCE4EC {
    class HavenApp {
        + agent: BaseAgent
        + mcp_manager: MCPManager
        + running: bool
        --
        + start(greeting_task)
        - _init_agent()
        - _load_skills()
        - _init_mcp()
        - _chat(user_input)
        - _execute_tool(name, args) : str
        - _handle_command(text) : bool
        - _prompt() : str
        - _print_banner()
    }
}

' --------------------------------------------------------------------------
' Config Layer
' --------------------------------------------------------------------------

package "config" #F3E5F5 {
    class Settings <<singleton>> {
        + agent_max_iterations: int
        + agent_max_execution_time: int
        + web_search_api_key: str
        + web_search_engine: str
        + email_smtp_host: str
        + email_smtp_port: int
        + email_smtp_username: str
        + email_smtp_password: str
        + email_use_tls: bool
        + email_imap_host: str
        + email_imap_port: int
        + email_imap_username: str
        + email_imap_password: str
        + email_poll_interval: int
        + email_user_whitelist: str
        + email_digest_time: str
        + rag_embedding_model: str
        + rag_embedding_api_base: str
        + rag_chunk_size: int
        + rag_chunk_overlap: int
        + rag_top_k: int
        + mcp_enabled: bool
        + daemon_socket_enabled: bool
        + daemon_socket_host: str
        + daemon_socket_port: int
        + daemon_email_enabled: bool
        + memory_enabled: bool
        + memory_extract_after_turn: bool
        + memory_min_confidence: float
        + skill_directory: str
        + project_root: Path
        --
        + {static} get_mcp_config() : list[dict]
    }
}

' --------------------------------------------------------------------------
' Relationships
' --------------------------------------------------------------------------

BaseAgent <|-- GeneralAgent
BaseAgent <|-- OrchestratorAgent
BaseAgent *-- AgentMemory
BaseAgent --> ToolRegistry : uses
BaseAgent --> RAGEngine : optional
BaseAgent *-- BaseSkill : skills

AgentMemory *-- SQLiteMemoryStore : _store
AgentMemory ..> "LLM" : extract_facts()

GeneralAgent ..> SkillLoader : loads
HavenApp --> GeneralAgent : creates
HavenApp --> SkillLoader : uses
HavenApp --> Settings : reads
HavenApp --> MCPManager : owns

MCPManager *-- MCPServerConfig : configs
MCPManager ..> "mcp.json" : reads
BaseAgent ..> MCPManager : register_mcp_tools(tools)

SkillLoader ..> BaseSkill : creates
SkillRegistry --> BaseSkill : registers
BaseSkill ..> "skills/*.md" : from

'OrchestratorAgent' *--> BaseAgent : sub_agents

BaseChannel <|-- SocketChannel
BaseChannel <|-- EmailChannel
BaseChannel --> BaseAgent : _agent
EmailChannel --> EmailService : wraps
HavenDaemon --> BaseAgent : owns
HavenDaemon *-- BaseChannel : channels
HavenDaemon --> Settings : reads
HavenDaemon --> MCPManager : owns

HavenApp ..> HavenDaemon : haven serve
HavenApp ..> SQLiteMemoryStore : persists to

@enduml
